# ==============================================================================
# NOI EXPAT OPEN — TELEGRAM BOT & SUPABASE CONFIGURATION
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
# Example: 7123456789:AAH...
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 2. Administrator Telegram User IDs (comma-separated)
# You can find your ID by sending /my_id to the bot or via @userinfobot
# Example: 12345678,87654321
ADMIN_TELEGRAM_IDS=YOUR_TELEGRAM_USER_ID

# 3. Supabase Project URL
SUPABASE_URL=https://dzlogbirnflzygrsekfb.supabase.co

# 4. Supabase Service Role Secret Key (REQUIRED for the Bot to write to DB)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 5. Supabase Anon Public Key (used by Frontend)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 6. Tournament Identifier
TOURNAMENT_ID=picklehead-individual-doubles

# 7. Frontend URL on GitHub Pages
FRONTEND_URL=https://gagapuh.github.io/noi-expat-open
